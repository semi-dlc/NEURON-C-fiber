    "   \"source\": [\n",
    "    \"# For each parameter, normalize each metric by its value at the reference dg.\\n\",\n",
    "    \"# Reference dg: changes[i_normal] if available (params using `changes`),\\n\",\n",
    "    \"# otherwise the first available dg (vRest uses changes_v_rest, gNav18 uses changes_gNav18).\\n\",\n",
    "    \"fig, axes = plt.subplots(len(params_dict), len(slowing_name), figsize=(35, 5 * len(params_dict)))\\n\",\n",
    "    \"for i, (name, dg_dict) in enumerate(params_dict.items()):\\n\",\n",
    "    \"    dg_list = list(dg_dict.keys())\\n\",\n",
    "    \"    ref_dg = changes[i_normal] if changes[i_normal] in dg_dict else dg_list[0]\\n\",\n",
    "    \"    for j, sname in enumerate(slowing_name):\\n\",\n",
    "    \"        ref_val = slowing_dict[name][ref_dg].get(sname, np.nan)\\n\",\n",
    "    \"        values = [slowing_dict[name][dg].get(sname, np.nan) / ref_val for dg in dg_list]\\n\",\n",
    "    \"        axes[i, j].plot(dg_list, values, alpha=0.8, label=name)\\n\",\n",
    "    \"        axes[i, j].set_xlabel(f\\\"Change {name}\\\")\\n\",\n",
    "    \"        axes[i, 0].set_ylabel(\\\"Relative change in velocity\\\")\\n\",\n",
    "    \"        for k in (1, 2, 3):\\n\",\n",
    "    \"            axes[i, k].set_ylabel(\\\"Relative change in latency\\\")\\n\",\n",
    "    \"        axes[i, 4].set_ylabel(\\\"Relative time to 50% recovery\\\")\\n\",\n",
