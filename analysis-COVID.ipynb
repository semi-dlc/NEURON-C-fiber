    "    \"    TimeTo50Percent = 0\\n\",\n",
    "    \"    return (initial_velocity, Slow025StartToEnd, Slow025EndToFast2HzEnd, Fast2HzStartToPost30S, TimeTo50Percent,\\n\",\n",
    "    \"            latency_points)\\n\"\n",
